# Environment Variables
# Copy this file to .env and fill in the values before running the project.

# PostgreSQL connection string
# Example: postgresql://username:password@localhost:5432/learninghub
DATABASE_URL="postgresql://user:password@localhost:5432/learninghub"

# NextAuth
# Your application URL (e.g. http://localhost:3000 in development)
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Set automatically by Vercel on deployment (optional in development)
NEXT_PUBLIC_VERCEL_URL=""
